<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QRaft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Cold-start splash: cyberpunk hero, then MainActivity switches to Theme.QRaft. -->
    <style name="Theme.QRaft.Splash" parent="Theme.QRaft">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
