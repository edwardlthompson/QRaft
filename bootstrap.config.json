{
  "schema_version": 1,
  "project_name": "QRaft",
  "purpose": "Craft custom QR codes for widgets, lock-screen glance panels, and full-screen wallpapers. Offline F-Droid-friendly Android app.",
  "stack": "android",
  "license": "Apache-2.0",
  "distribution_tier": "foss",
  "agent_adapters": {
    "cursor_rules": true,
    "claude": true,
    "copilot": true,
    "gemini": true,
    "windsurf": true,
    "cline": true,
    "aider": true,
    "continue": true
  },
  "security": {
    "dependabot": true,
    "code_scanning": true,
    "secret_detection": true
  },
  "hooks": {
    "preflight": true,
    "post_sync_adapters": true,
    "post_checklist": true,
    "post_git_init": false,
    "post_git_commit": false,
    "post_install_deps": false,
    "post_run_tests": false,
    "post_welcome_issue": false
  },
  "crash_proxy": {
    "enabled": false
  }
}
